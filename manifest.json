{
  "manifest_version": 3,
  "name": "Tempo",
  "version": "0.1",
  "description": "Extensão que permite ajustar a velocidade de reprodução de vídeos.",
  "icons": {
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}